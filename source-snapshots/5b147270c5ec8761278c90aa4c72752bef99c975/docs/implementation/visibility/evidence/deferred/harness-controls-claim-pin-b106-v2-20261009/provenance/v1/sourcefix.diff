+        assert_eq!(observed.receipt["tool"]["version"], Value::Null);
+        assert_eq!(observed.receipt["tool"]["list_argv"], Value::Null);
+        assert!(
+            fixture.trace().is_empty(),
+            "invalid pin must fail before version/setup probes: {case}"
+        );
+    }
+}
