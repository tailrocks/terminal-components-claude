+#[cfg(unix)]
+use tuiscotti_core::frame::{Cursor, CursorStyle};
+
+/// Project the backend's raw cursor state into the canonical frame.
+///
+/// Coordinates, shape, and blink state are preserved even when the cursor is
+/// hidden or its position is outside the viewport. Visibility is true only
+/// when the backend reports a visible cursor at an in-bounds position.
+#[cfg(unix)]
+pub(crate) fn project_cursor(
+    row: u16,
+    col: u16,
+    style_code: u16,
+    backend_visible: bool,
+    cols: u16,
+    rows: u16,
+) -> Cursor {
+    let style = match style_code {
+        3 | 4 => CursorStyle::Underline,
+        5 | 6 => CursorStyle::Bar,
+        _ => CursorStyle::Block,
+    };
+    Cursor {
+        x: col,
+        y: row,
+        visible: backend_visible && row < rows && col < cols,
+        style,
+        blinking: matches!(style_code, 1 | 3 | 5),
+    }
+}
+
+#[cfg(all(test, unix))]
+mod cursor_projection_tests {
+    use super::project_cursor;
+    use tuiscotti_core::frame::{Cursor, CursorStyle};
+
+    #[test]
+    fn hidden_cursor_preserves_raw_coordinates_style_and_blink() {
+        assert_eq!(
+            project_cursor(1, 3, 3, false, 8, 4),
+            Cursor {
+                x: 3,
+                y: 1,
+                visible: false,
+                style: CursorStyle::Underline,
+                blinking: true,
+            }
+        );
+    }
+
+    #[test]
+    fn hidden_pending_wrap_preserves_column_equal_to_width() {
+        assert_eq!(
+            project_cursor(2, 8, 5, false, 8, 4),
+            Cursor {
+                x: 8,
+                y: 2,
+                visible: false,
+                style: CursorStyle::Bar,
+                blinking: true,
+            }
+        );
+    }
+
+    #[test]
+    fn style_code_matrix_preserves_default_and_six_decscusr_shapes() {
+        // Termpane exposes zero as its default sentinel and cannot distinguish
+        // that initial value from an explicit CSI 0 request. Preserve the
+        // canonical Cursor default policy here; this does not claim to retain
+        // xterm's explicit CSI 0 blinking-block distinction.
+        let cases = [
+            (0, CursorStyle::Block, false),
+            (1, CursorStyle::Block, true),
+            (2, CursorStyle::Block, false),
+            (3, CursorStyle::Underline, true),
+            (4, CursorStyle::Underline, false),
+            (5, CursorStyle::Bar, true),
+            (6, CursorStyle::Bar, false),
+        ];
+
+        for (style_code, style, blinking) in cases {
+            assert_eq!(
+                project_cursor(1, 3, style_code, true, 8, 4),
+                Cursor {
+                    x: 3,
+                    y: 1,
+                    visible: true,
+                    style,
+                    blinking,
+                },
+                "DECSCUSR style code {style_code}"
+            );
+        }
+    }
+
+    #[test]
+    fn visibility_requires_backend_and_bounds_without_clamping_raw_position() {
+        assert_eq!(
+            project_cursor(1, 3, 3, false, 8, 4),
+            Cursor {
+                x: 3,
+                y: 1,
+                visible: false,
+                style: CursorStyle::Underline,
+                blinking: true,
+            },
+            "backend-hidden cursor retains its shape and blink state"
+        );
+        assert_eq!(
+            project_cursor(5, 3, 6, true, 8, 4),
+            Cursor {
+                x: 3,
+                y: 5,
+                visible: false,
+                style: CursorStyle::Bar,
+                blinking: false,
+            },
+            "out-of-bounds row stays raw but is not visible"
+        );
+        assert_eq!(
+            project_cursor(2, 8, 5, true, 8, 4),
+            Cursor {
+                x: 8,
+                y: 2,
+                visible: false,
+                style: CursorStyle::Bar,
+                blinking: true,
+            },
+            "pending-wrap column equal to width stays raw but is not visible"
+        );
+    }
+}
