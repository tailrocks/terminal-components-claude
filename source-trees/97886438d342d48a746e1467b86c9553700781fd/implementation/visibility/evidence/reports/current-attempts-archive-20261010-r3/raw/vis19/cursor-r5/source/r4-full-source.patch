+#[test]
+fn hidden_cup_cursor_coordinates_match_live_and_replay() {
+    let output = b"\x1b[?25l\x1b[3 q\x1b[2;4H";
+    let replayed = replay_bytes(output, 8, 4).expect("replay_bytes succeeds");
+    let live = live_cursor_from_output("stty -echo; printf '\\033[?25l\\033[3 q\\033[2;4H'", 8, 4);
+    let expected = Cursor {
+        x: 3,
+        y: 1,
+        visible: false,
+        style: CursorStyle::Underline,
+        blinking: true,
+    };
+
+    assert_eq!(replayed.screen.cursor(), &expected);
+    assert_eq!(live, expected);
+    assert_eq!(&live, replayed.screen.cursor());
+}
