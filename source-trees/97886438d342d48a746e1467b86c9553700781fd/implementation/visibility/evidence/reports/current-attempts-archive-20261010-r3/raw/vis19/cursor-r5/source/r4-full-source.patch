+fn live_cursor_from_output(command: &str, cols: u16, rows: u16) -> Cursor {
+    let s = Tui::new(["/bin/sh", "-c", command])
+        .env("ENV", "/dev/null")
+        .size(cols, rows)
+        .spawn()
+        .expect("spawn succeeds");
+    let waited = s
+        .wait_exit(deadline(10), &cancel())
+        .expect("wait_exit succeeds");
+    assert!(waited.status.success());
+    let cursor = (*waited.observation.screen.cursor()).clone();
+    s.close().expect("close succeeds");
+    cursor
+}
