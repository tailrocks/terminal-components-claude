+struct RawOutputCapture {
+    inner: Mutex<RawOutputCaptureInner>,
+}
+
+struct RawOutputCaptureInner {
+    path: PathBuf,
+    file: std::fs::File,
+    captured_output_bytes: Option<u64>,
+    processed_output_offset: Option<u64>,
+    drained: bool,
+    flushed: bool,
+    finalized: bool,
+    errors: Vec<String>,
+}
+
+impl RawOutputCapture {
+    fn create(options: &crate::api::RawOutputCaptureOptions) -> anyhow::Result<Arc<Self>> {
+        let path = options.path();
+        if path.as_os_str().is_empty() {
+            anyhow::bail!("raw output capture path must not be empty");
+        }
+        if let Some(parent) = path
+            .parent()
+            .filter(|parent| !parent.as_os_str().is_empty())
+        {
+            std::fs::create_dir_all(parent)?;
+        }
+        let file = OpenOptions::new().write(true).create_new(true).open(path)?;
+        Ok(Arc::new(Self {
+            inner: Mutex::new(RawOutputCaptureInner {
+                path: path.to_path_buf(),
+                file,
+                captured_output_bytes: Some(0),
+                processed_output_offset: Some(0),
+                drained: false,
+                flushed: false,
+                finalized: false,
+                errors: Vec::new(),
+            }),
+        }))
+    }
+
+    fn record_output(&self, bytes: &[u8]) -> std::io::Result<()> {
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let mut written = 0;
+        while written < bytes.len() {
+            match inner.file.write(&bytes[written..]) {
+                Ok(0) => {
+                    let error = std::io::Error::new(
+                        std::io::ErrorKind::WriteZero,
+                        "raw output capture wrote zero bytes",
+                    );
+                    push_capture_error(&mut inner, format!("raw output write failed: {error}"));
+                    return Err(error);
+                }
+                Ok(count) => {
+                    written += count;
+                    inner.captured_output_bytes = inner
+                        .captured_output_bytes
+                        .and_then(|total| total.checked_add(u64::try_from(count).ok()?));
+                    if inner.captured_output_bytes.is_none() {
+                        push_capture_error(
+                            &mut inner,
+                            "raw output capture byte count overflow".to_string(),
+                        );
+                    }
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(error) => {
+                    push_capture_error(&mut inner, format!("raw output write failed: {error}"));
+                    return Err(error);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn finish(&self) -> std::io::Result<()> {
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.drained = true;
+        match inner.file.flush() {
+            Ok(()) => {
+                inner.flushed = true;
+                Ok(())
+            }
+            Err(error) => {
+                push_capture_error(&mut inner, format!("raw output flush failed: {error}"));
+                Err(error)
+            }
+        }
+    }
+
+    fn record_processed_output(&self, bytes: usize) {
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(offset) = inner.processed_output_offset {
+            inner.processed_output_offset = u64::try_from(bytes)
+                .ok()
+                .and_then(|count| offset.checked_add(count));
+            if inner.processed_output_offset.is_none() {
+                push_capture_error(
+                    &mut inner,
+                    "processed PTY output offset overflow".to_string(),
+                );
+            }
+        }
+    }
+
+    fn record_error(&self, message: String) {
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !inner.finalized {
+            push_capture_error(&mut inner, message);
+        }
+    }
+
+    fn status(&self) -> crate::api::RawOutputCaptureStatus {
+        let inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        capture_status(&inner)
+    }
+
+    fn finalize(&self) -> crate::api::RawOutputCaptureStatus {
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !inner.drained {
+            push_capture_error(
+                &mut inner,
+                "incomplete PTY output drain: capture finalized before EOF".to_string(),
+            );
+        }
+        inner.finalized = true;
+        capture_status(&inner)
