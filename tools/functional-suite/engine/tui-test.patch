+    path: PathBuf,
+}
+
+impl RawOutputCaptureOptions {
+    /// Capture raw PTY output to `path`.
+    pub fn new(path: impl Into<PathBuf>) -> Self {
+        Self { path: path.into() }
+    }
+
+    /// The output file path.
+    pub fn path(&self) -> &std::path::Path {
+        &self.path
+    }
+}
