+}
+
+fn capture_status(inner: &RawOutputCaptureInner) -> crate::api::RawOutputCaptureStatus {
+    let complete = inner.drained
+        && inner.flushed
+        && inner.errors.is_empty()
+        && inner.captured_output_bytes.is_some()
+        && inner.captured_output_bytes == inner.processed_output_offset;
+    crate::api::RawOutputCaptureStatus {
+        path: inner.path.clone(),
+        setup_complete: true,
+        processed_output_offset: inner.processed_output_offset,
+        captured_output_bytes: inner.captured_output_bytes,
+        drained: inner.drained,
+        flushed: inner.flushed,
+        complete,
+        errors: inner.errors.clone(),
+    }
+}
+
+fn push_capture_error(inner: &mut RawOutputCaptureInner, message: String) {
+    if !inner.errors.contains(&message) {
+        inner.errors.push(message);
+    }
+}
