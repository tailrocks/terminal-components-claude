+    pub(crate) fn close_until(&self, deadline: Instant) -> Result<(), String> {
+        self.closed.store(true, Ordering::Release);
+        let mut errors = Vec::new();
+        match lock_until(&self.child, deadline, "PTY child lock") {
+            Ok(mut child) => match child_status(child.as_mut()) {
+                Ok(Some(_)) => {}
+                Ok(None) => {
+                    if let Err(error) = child.kill() {
+                        errors.push(format!("failed to terminate PTY child: {error}"));
+                    }
+                }
+                Err(error) => {
+                    errors.push(format!("failed to query PTY child status: {error}"));
+                    if let Err(kill_error) = child.kill() {
+                        errors.push(format!("failed to terminate PTY child: {kill_error}"));
+                    }
+                }
+            },
+            Err(error) => errors.push(error),
+        }
+        let (key, disposal) = pty_disposal_slot(&self.closed, deadline)?;
+        let mut disposal =
+            lock_until_with_immediate_try(&disposal, deadline, "PTY disposal state lock")?;
+        if let Err(error) = stage_pty_resource(
+            &self.master,
+            &mut disposal.master,
+            deadline,
+            "PTY master lock",
+        ) {
+            return Err(join_close_errors(errors, error));
+        }
+        if let Err(error) = dispose_pty_resource_until(&mut disposal.master, "PTY master", deadline) {
+            return Err(join_close_errors(errors, error));
+        }
+        if let Err(error) = stage_pty_resource(
+            &self.writer,
+            &mut disposal.writer,
+            deadline,
+            "PTY writer lock",
+        ) {
+            return Err(join_close_errors(errors, error));
+        }
+        if let Err(error) = dispose_pty_resource_until(&mut disposal.writer, "PTY writer", deadline) {
+            return Err(join_close_errors(errors, error));
+        }
+        if Instant::now() >= deadline {
+            errors.push("PTY close exceeded its deadline".to_string());
+        }
+        if errors.is_empty() {
+            drop(disposal);
+            remove_pty_disposal_slot(key, &self.closed);
+            Ok(())
+        } else {
+            Err(errors.join("; "))
+        }
+    }
