+
+fn remove_pty_disposal_slot(key: usize, closed: &Arc<AtomicBool>) {
+    let Some(registry) = PTY_DISPOSALS.get() else {
+        return;
+    };
+    let Ok(mut registry) = registry.try_lock() else {
+        return;
+    };
+    let Some(entry) = registry.get(&key) else {
+        return;
+    };
+    if !entry
+        .owner
+        .upgrade()
+        .is_some_and(|owner| Arc::ptr_eq(&owner, closed))
+    {
+        return;
+    }
+    let state = match entry.pending.try_lock() {
+        Ok(state) => state,
+        Err(std::sync::TryLockError::Poisoned(error)) => error.into_inner(),
+        Err(std::sync::TryLockError::WouldBlock) => return,
+    };
+    // Keep any retained handle owned by the sidecar; dropping it here could
+    // run a blocking PTY destructor on the caller.
+    let still_owned = state.master.retained.is_some()
+        || state.writer.retained.is_some()
+        || state.master.pending.is_some()
