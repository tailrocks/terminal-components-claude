+fn wait_for_deadline(deadline: Instant) {
+    let remaining = deadline.saturating_duration_since(Instant::now());
+    if !remaining.is_zero() {
+        std::thread::sleep(Duration::from_millis(10).min(remaining));
+    }
+}
+
+fn lock_mutex_until<'a, T>(
+    mutex: &'a Mutex<T>,
+    deadline: Instant,
+    name: &str,
+) -> Result<MutexGuard<'a, T>, TuiTestError> {
+    loop {
+        if Instant::now() >= deadline {
+            return Err(TuiTestError::internal(format!(
+                "{name} exceeded the capture deadline"
+            )));
+        }
+        match mutex.try_lock() {
+            Ok(guard) => return Ok(guard),
+            Err(TryLockError::Poisoned(error)) => return Ok(error.into_inner()),
+            Err(TryLockError::WouldBlock) if Instant::now() >= deadline => {
+                return Err(TuiTestError::internal(format!(
+                    "{name} exceeded the capture deadline"
+                )));
+            }
+            Err(TryLockError::WouldBlock) => wait_for_deadline(deadline),
+        }
+    }
+}
+
+fn lock_write_until<'a, T>(
+    lock: &'a RwLock<T>,
+    deadline: Instant,
+    name: &str,
+) -> Result<RwLockWriteGuard<'a, T>, TuiTestError> {
+    loop {
+        if Instant::now() >= deadline {
+            return Err(TuiTestError::internal(format!(
+                "{name} exceeded the capture deadline"
+            )));
+        }
+        match lock.try_write() {
+            Ok(guard) => return Ok(guard),
+            Err(TryLockError::Poisoned(error)) => return Ok(error.into_inner()),
+            Err(TryLockError::WouldBlock) if Instant::now() >= deadline => {
+                return Err(TuiTestError::internal(format!(
+                    "{name} exceeded the capture deadline"
+                )));
+            }
+            Err(TryLockError::WouldBlock) => wait_for_deadline(deadline),
+        }
+    }
+}
+
+fn lock_read_until<'a, T>(
+    lock: &'a RwLock<T>,
+    deadline: Instant,
+    name: &str,
+) -> Result<RwLockReadGuard<'a, T>, TuiTestError> {
+    loop {
+        if Instant::now() >= deadline {
+            return Err(TuiTestError::internal(format!(
+                "{name} exceeded the capture deadline"
+            )));
+        }
+        match lock.try_read() {
+            Ok(guard) => return Ok(guard),
+            Err(TryLockError::Poisoned(error)) => return Ok(error.into_inner()),
+            Err(TryLockError::WouldBlock) if Instant::now() >= deadline => {
+                return Err(TuiTestError::internal(format!(
+                    "{name} exceeded the capture deadline"
+                )));
+            }
+            Err(TryLockError::WouldBlock) => wait_for_deadline(deadline),
+        }
+    }
+}
+
+fn lock_mutex_for_deadline<'a, T>(
+    mutex: &'a Mutex<T>,
+    deadline: Option<Instant>,
+    name: &str,
+) -> Result<MutexGuard<'a, T>, TuiTestError> {
+    match deadline {
+        Some(deadline) => lock_mutex_until(mutex, deadline, name),
+        None => Ok(mutex
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)),
+    }
+}
+
+fn lock_read_for_deadline<'a, T>(
+    lock: &'a RwLock<T>,
+    deadline: Option<Instant>,
+    name: &str,
+) -> Result<RwLockReadGuard<'a, T>, TuiTestError> {
+    match deadline {
+        Some(deadline) => lock_read_until(lock, deadline, name),
+        None => Ok(lock
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)),
+    }
+}
+
+fn ensure_before_deadline(
+    deadline: Option<Instant>,
+    context: &str,
+) -> Result<(), TuiTestError> {
+    if deadline.is_some_and(|deadline| Instant::now() >= deadline) {
+        return Err(TuiTestError::internal(format!(
+            "{context} exceeded the capture deadline"
+        )));
+    }
+    Ok(())
+}
+
+fn run_bounded_completion<T>(
+    deadline: Option<Instant>,
+    operation: &'static str,
+    work: impl FnOnce() -> Result<T, String> + Send + 'static,
+    cleanup_if_unobserved: impl FnOnce(T) + Send + 'static,
+) -> Result<T, TuiTestError>
+where
+    T: Send + 'static,
+{
+    let Some(deadline) = deadline else {
+        return work().map_err(TuiTestError::internal);
+    };
+    ensure_before_deadline(Some(deadline), operation)?;
+    let (reply, response) = std::sync::mpsc::sync_channel(0);
+    let worker_name = format!("tui-test-{operation}");
+    std::thread::Builder::new()
+        .name(worker_name)
+        .spawn(move || {
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(work))
+                .unwrap_or_else(|payload| {
+                    Err(format!(
+                        "{operation} worker panicked: {}",
+                        panic_message(payload.as_ref())
+                    ))
+                });
+            if let Err(unsent) = reply.send(result) {
+                if let Ok(value) = unsent.0 {
+                    cleanup_if_unobserved(value);
+                }
+            }
+        })
+        .map_err(|error| {
+            TuiTestError::internal(format!("failed to start {operation} worker: {error}"))
+        })?;
+    response
+        .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+        .map_err(|error| match error {
+            std::sync::mpsc::RecvTimeoutError::Timeout => {
+                TuiTestError::internal(format!("{operation} exceeded the capture deadline"))
+            }
+            std::sync::mpsc::RecvTimeoutError::Disconnected => {
+                TuiTestError::internal(format!("{operation} worker stopped without a reply"))
+            }
+        })?
+        .map_err(TuiTestError::internal)
+}
