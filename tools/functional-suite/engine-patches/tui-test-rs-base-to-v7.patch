+            return Ok((key, entry.pending.clone()));
+        }
+    }
+    let pending = Arc::new(Mutex::new(PtyDisposalState::default()));
+    registry.insert(
+        key,
+        PtyDisposalEntry {
+            owner: Arc::downgrade(closed),
+            pending: pending.clone(),
+        },
+    );
+    Ok((key, pending))
