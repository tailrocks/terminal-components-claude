{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "termrock-spec/parity-oracle-capture-receipt-v2",
  "title": "Termrock normalized-existing-build immutable-tag actual-only capture receipt v2",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "state",
    "oracle_identity",
    "validator_helper",
    "suite",
    "case",
    "environment",
    "renderer",
    "write_policy",
    "checks",
    "artifacts",
    "capture_status",
    "execution_anchor_status",
    "qualification",
    "admission_status"
  ],
  "properties": {
    "schema": {
      "const": "termrock-spec/parity-oracle-capture-receipt-v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "capture_recorded",
        "capture_partial"
      ]
    },
    "oracle_identity": {
      "$ref": "#/$defs/oracle_identity"
    },
    "validator_helper": {
      "$ref": "#/$defs/evidence_reference"
    },
    "suite": {
      "$ref": "#/$defs/suite"
    },
    "case": {
      "$ref": "#/$defs/case"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "renderer": {
      "$ref": "#/$defs/renderer"
    },
    "write_policy": {
      "$ref": "#/$defs/write_policy"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "capture_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ]
    },
    "execution_anchor_status": {
      "const": "unverified"
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    },
    "admission_status": {
      "const": "NOT_RUN"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
    },
    "evidence_reference": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "oracle_identity": {
      "type": "object",
      "required": [
        "tag_ref",
        "tag_object",
        "tag_commit",
        "git_object_replacement_policy",
        "git_lazy_fetch_policy",
        "source_snapshot_commit",
        "source_snapshot_tree",
        "source_snapshot_root",
        "source_snapshot_included_file_count",
        "build_artifact_root",
        "build",
        "source_inputs_sha256",
        "build_environment_sha256",
        "executable",
        "validator_execution",
        "normalized_existing_build_origin"
      ],
      "properties": {
        "tag_ref": {
          "const": "refs/tags/visual-baseline"
        },
        "tag_object": {
          "const": "1ee5ebdcb91fd87adb9a5b28e43d4c7f421706c5"
        },
        "tag_commit": {
          "const": "4a79c0a2d40fca46fc406b77157ce3b3f12ec16b"
        },
        "git_object_replacement_policy": {
          "const": "disabled-by-option-and-environment"
        },
        "git_lazy_fetch_policy": {
          "const": "disabled-by-environment"
        },
        "source_snapshot_commit": {
          "const": "4a79c0a2d40fca46fc406b77157ce3b3f12ec16b"
        },
        "source_snapshot_tree": {
          "$ref": "#/$defs/git_oid"
        },
        "source_snapshot_root": {
          "$ref": "#/$defs/absolute_path"
        },
        "source_snapshot_included_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "build_artifact_root": {
          "$ref": "#/$defs/absolute_path"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "source_inputs_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_environment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executable": {
          "$ref": "#/$defs/executable"
        },
        "validator_execution": {
          "$ref": "#/$defs/validator_execution"
        },
        "normalized_existing_build_origin": {
          "$ref": "#/$defs/normalized_existing_build_origin"
        }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": [
        "package_id",
        "target_name",
        "features",
        "default_features",
        "target_triple",
        "toolchain",
        "profile"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "target_name": {
          "const": "holla"
        },
        "features": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "default_features": {
          "const": true
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "const": "1.98.1"
        },
        "profile": {
          "const": "release"
        }
      },
      "additionalProperties": false
    },
    "executable": {
      "type": "object",
      "required": [
        "path",
        "expected_sha256",
        "actual_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "actual_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": [
        "revision",
        "digest",
        "compiled_digest",
        "case_set_digest",
        "profile_digest",
        "test_binary_digest",
        "dependency_lock_sha256",
        "platform"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "compiled_digest": {
          "$ref": "#/$defs/sha256"
        },
        "case_set_digest": {
          "$ref": "#/$defs/sha256"
        },
        "profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "test_binary_digest": {
          "$ref": "#/$defs/sha256"
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": [
        "cols",
        "rows"
      ],
      "properties": {
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "needle",
        "left",
        "right",
        "requires"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "needle": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "left": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "right": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "requires": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "id",
        "assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "app",
        "binary",
        "args",
        "geometry",
        "color_path",
        "legacy_snapshot_root",
        "screen",
        "substep",
        "case_set_sha256",
        "input_program_sha256",
        "checkpoints"
      ],
      "properties": {
        "id": {
          "const": "HELP-HOLLA-004"
        },
        "app": {
          "const": "holla"
        },
        "binary": {
          "const": "holla"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "color_path": {
          "type": "string",
          "minLength": 1
        },
        "legacy_snapshot_root": {
          "type": "string",
          "minLength": 1
        },
        "screen": {
          "type": "string",
          "minLength": 1
        },
        "substep": {
          "type": "string",
          "minLength": 1
        },
        "case_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_program_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/checkpoint"
          }
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "cleared",
        "cwd",
        "common",
        "case_allowlist",
        "case_values"
      ],
      "properties": {
        "cleared": {
          "const": true
        },
        "cwd": {
          "$ref": "#/$defs/absolute_path"
        },
        "common": {
          "type": "object",
          "required": [
            "TERM",
            "COLORTERM",
            "LC_ALL",
            "SHELL"
          ],
          "properties": {
            "TERM": {
              "type": "string"
            },
            "COLORTERM": {
              "type": "string"
            },
            "LC_ALL": {
              "type": "string"
            },
            "SHELL": {
              "const": "/bin/sh"
            }
          },
          "additionalProperties": false
        },
        "case_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "case_values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "renderer_fallback": {
      "type": "object",
      "required": [
        "description",
        "sha256"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "required": [
        "schema",
        "hash",
        "name",
        "renderer_version",
        "font_px",
        "cell_w",
        "cell_h",
        "pad",
        "scale",
        "default_fg",
        "default_bg",
        "indexed_palette",
        "face_hashes",
        "fallback_order",
        "cursor_policy",
        "blink_phase",
        "missing_glyph_policy"
      ],
      "properties": {
        "schema": {
          "const": "termrock-spec/tuiscotti-renderer-identity-v1"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "renderer_version": {
          "type": "integer",
          "minimum": 1
        },
        "font_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cell_w": {
          "type": "integer",
          "minimum": 1
        },
        "cell_h": {
          "type": "integer",
          "minimum": 1
        },
        "pad": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 1
        },
        "default_fg": {
          "$ref": "#/$defs/rgb"
        },
        "default_bg": {
          "$ref": "#/$defs/rgb"
        },
        "indexed_palette": {
          "type": "string"
        },
        "face_hashes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "fallback_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/renderer_fallback"
          }
        },
        "cursor_policy": {
          "type": "string",
          "minLength": 1
        },
        "blink_phase": {
          "type": "string",
          "minLength": 1
        },
        "missing_glyph_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "protected_root": {
      "type": "object",
      "required": [
        "kind",
        "role",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "subject_source",
            "subject_artifact",
            "oracle",
            "suite_checkout",
            "test_binary_parent",
            "subject_executable_parent",
            "tag_builder_evidence",
            "tag_builder_evidence_parent",
            "tag_validator_helper",
            "tag_validator_helper_parent"
          ]
        },
        "role": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "oracle"
              ]
            }
          ]
        },
        "path": {
          "$ref": "#/$defs/absolute_path"
        }
      },
      "additionalProperties": false
    },
    "actual_output_root": {
      "type": "object",
      "required": [
        "role",
        "path"
      ],
      "properties": {
        "role": {
          "const": "oracle"
        },
        "path": {
          "$ref": "#/$defs/absolute_path"
        }
      },
      "additionalProperties": false
    },
    "write_policy": {
      "type": "object",
      "required": [
        "schema",
        "write_root",
        "receipt_path",
        "subject_cwd",
        "protected_roots",
        "actual_output_roots",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "termrock-spec/parity-write-policy-v2"
        },
        "write_root": {
          "$ref": "#/$defs/absolute_path"
        },
        "receipt_path": {
          "$ref": "#/$defs/absolute_path"
        },
        "subject_cwd": {
          "$ref": "#/$defs/absolute_path"
        },
        "protected_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/protected_root"
          }
        },
        "actual_output_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/actual_output_root"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "subject_role",
        "case_id",
        "checkpoint_id",
        "dimension",
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject_role": {
          "const": "oracle"
        },
        "case_id": {
          "const": "HELP-HOLLA-004"
        },
        "checkpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": [
            "build",
            "launch",
            "first_frame",
            "interaction",
            "visual",
            "exit",
            "restoration"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "BLOCKED",
            "NOT_RUN",
            "STALE",
            "NOT_APPLICABLE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "subject_role",
        "case_id",
        "checkpoint_id",
        "format",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "subject_role": {
          "const": "oracle"
        },
        "case_id": {
          "const": "HELP-HOLLA-004"
        },
        "checkpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "frame_json",
            "ansi",
            "html",
            "png",
            "ascii",
            "txt",
            "ascii_loss_json",
            "png_fidelity_json",
            "observations_json",
            "manifest_json"
          ]
        },
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "tool_identity": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "validator_execution": {
      "type": "object",
      "required": [
        "repository",
        "git_dir",
        "git_common_dir",
        "toolchain",
        "python",
        "git",
        "helper_transport",
        "executed_helper_sha256",
        "python_sha256_before",
        "python_sha256_after",
        "git_sha256_before",
        "git_sha256_after"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/absolute_path"
        },
        "git_dir": {
          "$ref": "#/$defs/absolute_path"
        },
        "git_common_dir": {
          "$ref": "#/$defs/absolute_path"
        },
        "toolchain": {
          "$ref": "#/$defs/evidence_reference"
        },
        "python": {
          "$ref": "#/$defs/tool_identity"
        },
        "git": {
          "$ref": "#/$defs/tool_identity"
        },
        "helper_transport": {
          "const": "checked-source-absolute-git-dispatch-v1"
        },
        "executed_helper_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "python_sha256_before": {
          "$ref": "#/$defs/sha256"
        },
        "python_sha256_after": {
          "$ref": "#/$defs/sha256"
        },
        "git_sha256_before": {
          "$ref": "#/$defs/sha256"
        },
        "git_sha256_after": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "normalized_existing_build_origin": {
      "type": "object",
      "required": [
        "schema",
        "normalization_addendum",
        "build_result"
      ],
      "properties": {
        "schema": {
          "const": "termrock-spec/visual-tag-holla-normalized-existing-build-origin-v2"
        },
        "normalization_addendum": {
          "$ref": "#/$defs/evidence_reference"
        },
        "build_result": {
          "$ref": "#/$defs/evidence_reference"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "checks"
        ],
        "properties": {
          "checks": {
            "contains": {
              "type": "object",
              "required": [
                "dimension",
                "status"
              ],
              "properties": {
                "dimension": {
                  "const": "visual"
                },
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    }
  ]
}
