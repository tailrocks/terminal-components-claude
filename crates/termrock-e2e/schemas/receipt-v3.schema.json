{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "termrock-spec/parity-run-receipt-v3",
  "title": "Termrock shared PTY run receipt v3",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "source_pair",
    "suite",
    "coverage",
    "expected_generation",
    "trust",
    "write_policy",
    "checks",
    "artifacts",
    "build_evidence",
    "environment",
    "renderer"
  ],
  "properties": {
    "schema": {
      "const": "termrock-spec/parity-run-receipt-v3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/subject_identity"
      },
      "contains": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "reference"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "suite": {
      "type": "object",
      "required": [
        "revision",
        "digest",
        "compiled_digest",
        "case_set_digest",
        "case_input_sha256",
        "profile_digest",
        "test_binary_digest",
        "dependency_lock_sha256",
        "platform"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "compiled_digest": {
          "$ref": "#/$defs/sha256"
        },
        "case_set_digest": {
          "$ref": "#/$defs/sha256"
        },
        "case_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "test_binary_digest": {
          "$ref": "#/$defs/sha256"
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "expected_generation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/expected_generation"
        }
      ]
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "trust": {
      "type": "object",
      "required": [
        "status",
        "record_path",
        "record_sha256",
        "receipt_sha256",
        "write_policy_sha256",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "unverified"
          ]
        },
        "record_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute canonical filesystem path supplied by the caller; it locates the record but does not authorize it."
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "write_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "write_policy": {
      "$ref": "#/$defs/write_policy"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "build_evidence": {
      "type": "object",
      "required": [
        "subject_manifest",
        "source_inputs",
        "build_environment",
        "builder_run"
      ],
      "properties": {
        "subject_manifest": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "source_inputs": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "build_environment": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "builder_run": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "cleared",
        "cwd",
        "common",
        "case_allowlist",
        "case_values"
      ],
      "properties": {
        "cleared": {
          "const": true
        },
        "cwd": {
          "type": "string",
          "pattern": "^/",
          "minLength": 1
        },
        "common": {
          "type": "object",
          "required": [
            "TERM",
            "COLORTERM",
            "LC_ALL",
            "SHELL"
          ],
          "properties": {
            "TERM": {
              "type": "string",
              "minLength": 1
            },
            "COLORTERM": {
              "type": "string",
              "minLength": 1
            },
            "LC_ALL": {
              "type": "string",
              "minLength": 1
            },
            "SHELL": {
              "const": "/bin/sh"
            }
          },
          "additionalProperties": false
        },
        "case_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "case_values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "required": [
        "schema",
        "hash",
        "name",
        "renderer_version",
        "font_px",
        "cell_w",
        "cell_h",
        "pad",
        "scale",
        "default_fg",
        "default_bg",
        "indexed_palette",
        "face_hashes",
        "fallback_order",
        "cursor_policy",
        "blink_phase",
        "missing_glyph_policy"
      ],
      "properties": {
        "schema": {
          "const": "termrock-spec/tuiscotti-renderer-identity-v1"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "renderer_version": {
          "type": "integer",
          "minimum": 1
        },
        "font_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cell_w": {
          "type": "integer",
          "minimum": 1
        },
        "cell_h": {
          "type": "integer",
          "minimum": 1
        },
        "pad": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 1
        },
        "default_fg": {
          "$ref": "#/$defs/rgb"
        },
        "default_bg": {
          "$ref": "#/$defs/rgb"
        },
        "indexed_palette": {
          "type": "string",
          "minLength": 1
        },
        "face_hashes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "fallback_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fallback_face"
          }
        },
        "cursor_policy": {
          "enum": [
            "Show",
            "Hide"
          ]
        },
        "blink_phase": {
          "enum": [
            "On",
            "Off"
          ]
        },
        "missing_glyph_policy": {
          "enum": [
            "Strict",
            "Placeholder"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "coverage": {
      "type": "object",
      "required": [
        "schema",
        "suite_revision",
        "case_set_sha256",
        "profile_sha256",
        "selected_case_id",
        "registered_case_count",
        "checkpoint_count",
        "assertion_count",
        "deferred_row_count",
        "deferred_case_reference_count",
        "missing_historical_id",
        "coverage_rule",
        "cases",
        "deferred"
      ],
      "properties": {
        "schema": {
          "const": "termrock-e2e/coverage-metadata-v1"
        },
        "suite_revision": {
          "type": "string",
          "minLength": 1
        },
        "case_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_case_id": {
          "type": "string",
          "minLength": 1
        },
        "registered_case_count": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoint_count": {
          "type": "integer",
          "minimum": 1
        },
        "assertion_count": {
          "type": "integer",
          "minimum": 1
        },
        "deferred_row_count": {
          "type": "integer",
          "minimum": 1
        },
        "deferred_case_reference_count": {
          "type": "integer",
          "minimum": 1
        },
        "missing_historical_id": {
          "const": "BD-19"
        },
        "coverage_rule": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "app",
              "binary",
              "case_input_sha256",
              "checkpoint_count",
              "assertion_count",
              "selection_status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "app": {
                "type": "string",
                "minLength": 1
              },
              "binary": {
                "type": "string",
                "minLength": 1
              },
              "case_input_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "checkpoint_count": {
                "type": "integer",
                "minimum": 1
              },
              "assertion_count": {
                "type": "integer",
                "minimum": 1
              },
              "selection_status": {
                "enum": [
                  "SELECTED_FOR_THIS_RECEIPT",
                  "NOT_SELECTED_FOR_THIS_RECEIPT"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "deferred": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "cases",
              "owner",
              "inventory_status",
              "paired_observation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "inventory_status": {
                "const": "NOT_RUN"
              },
              "paired_observation": {
                "const": "NOT_DECLARED"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "protected_root": {
      "type": "object",
      "required": [
        "kind",
        "role",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "subject_source",
            "subject_artifact",
            "oracle",
            "suite_checkout",
            "expected_generation",
            "trust_record",
            "trust_record_parent",
            "test_binary_parent",
            "subject_executable_parent",
            "subject_build_evidence",
            "generation_admission_evidence",
            "generation_admission_evidence_parent",
            "oracle_capture_artifacts",
            "tag_source_snapshot",
            "tag_build_artifacts",
            "tag_validator_helper",
            "tag_validator_helper_parent"
          ]
        },
        "role": {
          "oneOf": [
            {
              "enum": [
                "reference",
                "candidate"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "actual_output_root": {
      "type": "object",
      "required": [
        "role",
        "path"
      ],
      "properties": {
        "role": {
          "enum": [
            "reference",
            "candidate"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "write_policy": {
      "type": "object",
      "required": [
        "schema",
        "write_root",
        "receipt_path",
        "protected_roots",
        "actual_output_roots",
        "sha256",
        "subject_cwd"
      ],
      "properties": {
        "schema": {
          "const": "termrock-spec/parity-write-policy-v2"
        },
        "write_root": {
          "type": "string",
          "minLength": 1
        },
        "receipt_path": {
          "type": "string",
          "minLength": 1
        },
        "protected_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/protected_root"
          }
        },
        "actual_output_roots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/actual_output_root"
          },
          "contains": {
            "properties": {
              "role": {
                "const": "reference"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "subject_cwd": {
          "type": "string",
          "pattern": "^/",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "mise_config": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "present",
            "path",
            "sha256"
          ],
          "properties": {
            "present": {
              "const": true
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "present",
            "path",
            "sha256"
          ],
          "properties": {
            "present": {
              "const": false
            },
            "path": {
              "type": "null"
            },
            "sha256": {
              "type": "null"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "build_facts": {
      "type": "object",
      "required": [
        "package_id",
        "target_name",
        "features",
        "default_features",
        "target_triple",
        "toolchain",
        "profile"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "target_name": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_features": {
          "type": "boolean"
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "build_inputs": {
      "type": "object",
      "required": [
        "manifest_sha256",
        "lock_sha256",
        "mise_config",
        "cargo_version",
        "rustc_version",
        "host_triple",
        "executed_argv"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mise_config": {
          "$ref": "#/$defs/mise_config"
        },
        "cargo_version": {
          "type": "string",
          "minLength": 1
        },
        "rustc_version": {
          "type": "string",
          "minLength": 1
        },
        "host_triple": {
          "type": "string",
          "minLength": 1
        },
        "executed_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "builder_receipt": {
      "type": "object",
      "required": [
        "schema",
        "source_commit",
        "package_id",
        "target_name",
        "requested_features",
        "default_features",
        "target_triple",
        "toolchain",
        "profile",
        "manifest_sha256",
        "lock_sha256",
        "mise_config",
        "cargo_version",
        "rustc_version",
        "host_triple",
        "executed_argv",
        "executable_path",
        "executable_sha256",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "termrock-spec/parity-subject-build-receipt-v1"
        },
        "source_commit": {
          "$ref": "#/$defs/source_commit"
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "target_name": {
          "type": "string",
          "minLength": 1
        },
        "requested_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_features": {
          "type": "boolean"
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mise_config": {
          "$ref": "#/$defs/mise_config"
        },
        "cargo_version": {
          "type": "string",
          "minLength": 1
        },
        "rustc_version": {
          "type": "string",
          "minLength": 1
        },
        "host_triple": {
          "type": "string",
          "minLength": 1
        },
        "executed_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "executable_path": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "executable_receipt": {
      "type": "object",
      "required": [
        "path",
        "expected_sha256",
        "actual_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "actual_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "subject_identity": {
      "type": "object",
      "required": [
        "role",
        "source_commit",
        "build",
        "build_inputs",
        "builder_receipt",
        "builder_receipt_sha256",
        "executable",
        "actual_output_root"
      ],
      "properties": {
        "role": {
          "enum": [
            "reference",
            "candidate"
          ]
        },
        "source_commit": {
          "$ref": "#/$defs/source_commit"
        },
        "build": {
          "$ref": "#/$defs/build_facts"
        },
        "build_inputs": {
          "$ref": "#/$defs/build_inputs"
        },
        "builder_receipt": {
          "$ref": "#/$defs/builder_receipt"
        },
        "builder_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executable": {
          "$ref": "#/$defs/executable_receipt"
        },
        "actual_output_root": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "expected_generation": {
      "type": "object",
      "required": [
        "id",
        "expected_sha256",
        "actual_sha256",
        "state",
        "admission_receipt_sha256",
        "root"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "actual_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "HASH_MATCH",
            "ADMITTED",
            "BLOCKED_MISSING_OR_INVALID"
          ]
        },
        "admission_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "root": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "subject_role",
        "case_id",
        "checkpoint_id",
        "dimension",
        "status",
