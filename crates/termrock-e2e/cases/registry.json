              "kind": "contains",
              "needle": "Save workspace"
            },
            {
              "id": "reopened.diff",
              "kind": "contains",
              "needle": "~ keep_awake true → false"
            }
          ]
        },
        {
          "op": "press",
          "key": "escape"
        },
        {
          "op": "checkpoint",
          "id": "06-cancelled-again",
          "wait": [
            {
              "kind": "contains",
              "needle": "• 1 change"
            },
            {
              "kind": "contains",
              "needle": "Workspaces › payments-platform › edit"
            },
            {
              "kind": "absent",
              "needle": "Save workspace"
            },
            {
              "kind": "absent",
              "needle": "~ keep_awake true → false"
            }
          ],
          "assertions": [
            {
              "id": "cancel_again.dirty_count",
              "kind": "contains",
              "needle": "• 1 change"
            },
            {
              "id": "cancel_again.editor_crumb",
              "kind": "contains",
              "needle": "Workspaces › payments-platform › edit"
            },
            {
              "id": "cancel_again.preview_absent",
              "kind": "absent",
              "needle": "Save workspace",
              "requires": "reopened.title"
            },
            {
              "id": "cancel_again.diff_absent",
              "kind": "absent",
              "needle": "~ keep_awake true → false",
              "requires": "reopened.diff"
            }
          ]
