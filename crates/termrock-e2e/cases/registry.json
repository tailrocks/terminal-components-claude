{
  "schema": "termrock-e2e/case-registry-v1",
  "suite_revision": "termrock-e2e-2026-10-08.1",
  "cases": [
    {
      "id": "HELP-HOLLA-004",
      "app": "holla",
      "binary": "holla",
      "args": ["--scenario", "rust-dirty", "--motion", "paused", "--frame", "40", "--color", "truecolor"],
      "geometry": {"cols": 120, "rows": 40},
      "color_path": "truecolor",
      "legacy_snapshot_root": "holla/flows/help/overlay",
      "screen": "finder",
      "substep": "help-overlay",
      "timeout_ms": 8000,
      "steps": [
        {
          "op": "checkpoint",
          "id": "00-boot",
          "wait": [{"kind": "contains", "needle": "holla❯"}, {"kind": "contains", "needle": "Type Search"}],
          "assertions": [
            {"id": "boot.placeholder", "kind": "contains", "needle": "Search actions and resources…"},
            {"id": "boot.finder_footer", "kind": "contains", "needle": "Type Search"},
            {"id": "boot.disk_cursor", "kind": "same_line", "left": "› Inspect 12 GB of generat…", "right": "12 GB generated artifacts"},
            {"id": "boot.world", "kind": "same_line", "left": "In", "right": "~/work/holla"}
          ]
        },
        {"op": "press", "key": "f1"},
        {
          "op": "checkpoint",
          "id": "01-help",
          "wait": [{"kind": "contains", "needle": "Key reference"}],
          "legacy_snapshot_path": "holla/flows/help/overlay/120x40/truecolor",
          "assertions": [
            {"id": "help.title_here", "kind": "same_line", "left": "Key reference", "right": "Here"},
            {"id": "help.finder_row", "kind": "same_line", "left": "Type", "right": "search actions and resources together"},
            {"id": "help.quit_row", "kind": "same_line", "left": "Ctrl+Q", "right": "quit with confirmation"},
            {"id": "help.footer", "kind": "contains", "needle": "↑↓ Scroll  Esc Close"},
            {"id": "help.finder_footer_absent", "kind": "absent", "needle": "Type Search", "requires": "boot.finder_footer"}
          ]
        },
        {"op": "press", "key": "escape"},
        {
          "op": "checkpoint",
          "id": "02-finder",
          "wait": [{"kind": "absent", "needle": "Key reference"}, {"kind": "contains", "needle": "Search actions and resources…"}],
          "assertions": [
            {"id": "finder.placeholder_restored", "kind": "contains", "needle": "Search actions and resources…"},
            {"id": "finder.quit_row_absent", "kind": "absent", "needle": "quit with confirmation", "requires": "help.quit_row"}
          ]
        },
        {"op": "press", "key": "f1"},
        {
          "op": "checkpoint",
          "id": "03-help-again",
          "wait": [{"kind": "contains", "needle": "Key reference"}],
          "assertions": [
            {"id": "reopen.title_here", "kind": "same_line", "left": "Key reference", "right": "Here"}
          ]
        }
      ]
    }
  ]
}
