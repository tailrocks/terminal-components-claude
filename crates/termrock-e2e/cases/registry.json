    {
      "id": "SHOWCASE-DIALOG-001",
      "app": "showcase",
      "binary": "showcase",
      "args": [
        "--page",
        "dialogs",
        "--color",
        "truecolor"
      ],
      "geometry": {
        "cols": 120,
        "rows": 40
      },
      "color_path": "truecolor",
      "environment": {},
      "steps": [
        {
          "op": "press",
          "key": "d"
        },
        {
          "op": "checkpoint",
          "id": "dialog.open",
          "wait": [
            {
              "kind": "contains",
              "needle": "Delete branch?"
