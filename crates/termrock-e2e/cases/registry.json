            {
              "id": "cancel.dirty_count",
              "kind": "contains",
              "needle": "• 1 change"
            },
            {
              "id": "cancel.editor_crumb",
              "kind": "contains",
              "needle": "Workspaces › payments-platform › edit"
            },
            {
              "id": "cancel.preview_absent",
