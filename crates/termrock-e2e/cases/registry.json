          "assertions": [
            {
              "id": "dialog.title",
              "kind": "contains",
              "needle": "Delete branch?"
            },
            {
              "id": "dialog.cancel",
              "kind": "contains",
              "needle": "Cancel"
            },
            {
              "id": "dialog.confirm",
              "kind": "contains",
              "needle": "Delete branch"
            }
          ],
          "legacy_snapshot_path": "showcase/flows/dialogs/destructive/120x40/truecolor"
        },
        {
          "op": "press",
          "key": "right"
        },
        {
          "op": "press",
          "key": "enter"
        },
        {
          "op": "checkpoint",
          "id": "dialog.confirmed",
          "wait": [
            {
              "kind": "contains",
              "needle": "Branch feat/rate-limit deleted"
            },
            {
              "kind": "absent",
              "needle": "Delete branch?"
            }
          ],
          "assertions": [
            {
              "id": "dialog.result",
              "kind": "contains",
              "needle": "Branch feat/rate-limit deleted"
            },
            {
              "id": "dialog.closed",
              "kind": "absent",
              "needle": "Delete branch?",
              "requires": "dialog.title"
            }
          ]
        }
      ],
      "legacy_snapshot_root": "showcase/flows/dialogs/destructive",
      "screen": "dialogs",
      "substep": "destructive-dialog",
      "timeout_ms": 8000
    },
