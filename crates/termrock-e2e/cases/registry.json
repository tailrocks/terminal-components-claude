            {
              "id": "preview.keep_awake_diff",
              "kind": "contains",
              "needle": "~ keep_awake true → false"
            },
            {
              "id": "preview.workspace_name",
              "kind": "contains",
              "needle": "payments-platform"
            },
            {
              "id": "preview.change_count",
              "kind": "contains",
              "needle": "1 change"
            },
            {
              "id": "preview.dirty_badge",
              "kind": "contains",
              "needle": "• 1 change"
            },
            {
              "id": "preview.dirty_tab",
              "kind": "contains",
