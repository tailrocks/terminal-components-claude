+fn decode_session_input(event: Event, esc_at: &mut Option<Instant>) -> Option<Input> {
+    Input::from_crossterm(event).map(|mut input| {
+        promote_escaped_alt(&mut input, esc_at);
+        input
+    })
+}
+
+fn promote_escaped_alt(input: &mut Input, esc_at: &mut Option<Instant>) {
+    let Input::Key(key) = input else {
+        *esc_at = None;
+        return;
+    };
+    if key.is(termrock_core::event::KeyCode::Esc) {
+        *esc_at = Some(Instant::now());
+        return;
+    }
+    let follow = esc_at.is_some_and(|at| at.elapsed() <= Duration::from_millis(100));
+    *esc_at = None;
+    if follow
+        && matches!(key.code, termrock_core::event::KeyCode::Char(_))
+        && key.bare_char().is_some()
+    {
+        key.mods |= termrock_core::event::KeyModifiers::ALT;
+    }
+}
