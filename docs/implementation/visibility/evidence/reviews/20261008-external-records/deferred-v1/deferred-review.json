  "findings": [
    {
      "details": "classify_execution returns exit code 1 whenever it sees a failed test, regardless of run_exit. The latest receipt correctly records Nextest exit 100, but the runner CLI returns 1. This violates the work plan requirement to preserve the real exit code and prevents callers from distinguishing the actual runner result. The existing failure test passes run_exit=1 and does not cover the observed Nextest exit 100.",
      "evidence": {
        "latest_nextest_run_argv": [
          "rustup",
