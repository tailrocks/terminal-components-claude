          "--run-ignored",
          "only",
          "--ignore-default-filter",
          "--color",
          "never",
          "--show-progress",
          "none",
          "--filterset",
          "package(=termrock-conformance) & binary(=control_states) & (test(=w01_brand_press_paints_distinct_from_hover) | test(=w02_button_disabled_suppresses_focus_gutter) | test(=w03_checkbox_compact_markers) | test(=w03_checkbox_checked_focus_hover_independent) | test(=w04_toggle_compact_markers) | test(=w05_radio_per_option_disabled) | test(=w05_radio_no_horizontal) | test(=w06_chipbar_closable_keyboard_dead) | test(=w06_chipbar_close_press_then_reorder_or_delete) | test(=w08_input_masked_clicks_follow_display) | test(=w08_input_down_only_does_not_edit) | test(=w08_input_navigation_paste_begins_editing) | test(=w08_input_external_change_is_not_silently_overwritten) | test(=w09_area_nav_enter_begins_without_newline) | test(=w09_area_nav_page_home_end_scroll_without_editing) | test(=w09_area_wheel_holds_past_caret_until_it_moves) | test(=w10_select_popup_edge_fade) | test(=w11_form_busy_enter_submit_blocked) | test(=w13_filter_backspace_removes_grapheme) | test(=w13_filter_wide_trail_cells_clear) | test(=w13_filter_reseed_selects_first_eligible) | test(=w16_steps_running_spinner_cycles_phases) | test(=w17_tabs_focused_pressed_bold)) - test(/(?i)(admission|approve|baseline|capture|snapshot|publish|write)/)",
