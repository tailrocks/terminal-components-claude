+
+#[test]
+fn zz_dump_page() {
+    let Ok(page) = std::env::var("DUMP_PAGE") else {
+        return;
+    };
+    let entry = NAV_ENTRIES
+        .iter()
+        .find(|e| format!("{:?}", e.id) == page)
+        .unwrap();
+    let sizes: Vec<(u16, u16)> = std::env::var("DUMP_SIZES")
+        .unwrap_or("80x24,120x40,220x70".into())
+        .split(',')
+        .map(|s| {
+            let (w, h) = s.split_once('x').unwrap();
+            (w.parse().unwrap(), h.parse().unwrap())
+        })
+        .collect();
+    for (w, h) in sizes {
+        let mut s = Shot::new(w, h, entry.id, Section::Playground).unwrap();
+        let l = s.view().last_layout();
+        println!(
+            "=== {w}x{h} content {:?} viewport {:?}",
+            l.content, l.viewport
+        );
+        println!("{}", text(s.term.backend().buffer()));
+        if std::env::var("DUMP_SCROLL").is_ok() {
+            s.view().scroll_to(usize::MAX, usize::MAX);
+            s.draw();
+            println!("--- scrolled end");
+            println!("{}", text(s.term.backend().buffer()));
+        }
+    }
+}
